---
import DefaultLayout from "../../../layouts/DefaultLayout.astro"
import { antiCheatChapters, antiCheatDoc } from "../../../data/antiCheatDocs"
---
<DefaultLayout title={antiCheatDoc.title} description={antiCheatDoc.description}>
	<section class="mt-12 max-w-5xl text-slate-900">
		<header class="mb-10 space-y-5 border-b border-slate-300 pb-8">
			<a href={antiCheatDoc.worksPath} class="futura text-xs uppercase tracking-[0.3em] text-slate-500 transition hover:text-[#FF4081]">
				Works / Research
			</a>
			<div class="space-y-4">
				<p class="futura text-xs uppercase tracking-[0.4em] text-slate-500">anti-cheat docs</p>
				<h1 class="heading-jp text-3xl leading-tight md:text-5xl">{antiCheatDoc.title}</h1>
				<p class="max-w-3xl text-base leading-relaxed text-slate-600 md:text-lg">{antiCheatDoc.description}</p>
			</div>
		</header>

		<ol class="border-y border-slate-300">
			{antiCheatChapters.map((chapter) => (
				<li class="border-b border-slate-300 last:border-b-0">
					<a href={chapter.href} class="group grid gap-3 py-5 transition sm:grid-cols-[72px_minmax(0,1fr)_auto] sm:items-start">
						<span class="futura text-sm uppercase tracking-[0.25em] text-slate-400">
							{String(chapter.order).padStart(2, "0")}
						</span>
						<span class="min-w-0">
							<span class="block text-xl font-semibold text-slate-900 transition group-hover:text-[#FF4081]">{chapter.title}</span>
							<span class="mt-1 block text-sm leading-relaxed text-slate-600">{chapter.description}</span>
						</span>
						<span aria-hidden="true" class="hidden text-xl text-slate-300 transition group-hover:translate-x-1 group-hover:text-[#FF4081] sm:block">→</span>
					</a>
				</li>
			))}
		</ol>
	</section>
</DefaultLayout>
