---
import DefaultLayout from "../../layouts/DefaultLayout.astro"

type WorkFrontmatter = {
	title: string
	titleEn?: string
	description?: string
	descriptionEn?: string
	pubDate?: string
	date?: string
	format?: string
	tags?: string[]
	tagsEn?: string[]
	contentLocale?: string
}

type WorkModule = {
	frontmatter: WorkFrontmatter
	url?: string
}

const workModules = import.meta.glob<WorkModule>("../works/*.md", {
	eager: true,
})

const works = Object.values(workModules)
	.map((item) => ({
		...item,
		pageUrl: item.url ?? "",
		pubDate: item.frontmatter.pubDate ?? item.frontmatter.date ?? null,
		displayTitle: item.frontmatter.titleEn ?? item.frontmatter.title,
		displayDescription:
			item.frontmatter.descriptionEn ??
			item.frontmatter.description ??
			"Details will be added later.",
		displayTags: item.frontmatter.tagsEn ?? item.frontmatter.tags ?? [],
	}))
	.sort((a, b) => {
		const dateA = a.pubDate ? new Date(a.pubDate).getTime() : 0
		const dateB = b.pubDate ? new Date(b.pubDate).getTime() : 0

		return dateB - dateA
	})

const formatLabel = (format?: string) => format?.toUpperCase() ?? "N/A"
---
<DefaultLayout
	title="Works"
	description="Works by mikio815"
>
	<section class="mt-12 max-w-4xl space-y-6 text-slate-900">
		<header class="mb-12 space-y-4">
			<h2 class="text-4xl md:text-6xl tussilago">Works</h2>
		</header>

		{works.length === 0 ? (
			<p class="text-gray-500">No works yet.</p>
		) : (
			<ul class="divide-y divide-slate-300 border-y border-slate-300">
				{works.map((work) => (
					<li>
						<a
							href={work.pageUrl}
							class="group flex items-start justify-between gap-6 py-6 transition"
						>
							<div>
								<div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.2em] text-gray-400 futura">
									<span>{work.pubDate ? new Date(work.pubDate).toLocaleDateString("en-US") : "N/A"}</span>
									{work.frontmatter.format && (
										<span class="inline-flex items-center rounded-full bg-slate-900 px-2.5 py-0.5 text-[0.65rem] font-semibold text-white">
											{formatLabel(work.frontmatter.format)}
										</span>
									)}
									{work.frontmatter.contentLocale && (
										<span class="inline-flex items-center rounded-full border border-slate-300 px-2.5 py-0.5 text-[0.65rem] font-semibold text-slate-500">
											{work.frontmatter.contentLocale}
										</span>
									)}
								</div>
								<h3 class="mt-2 text-2xl md:text-3xl text-gray-900 heading-jp transition group-hover:text-[#FF4081]">
									{work.displayTitle}
								</h3>
								<p class="mt-2 text-base leading-relaxed text-gray-600">
									{work.displayDescription}
								</p>
								{work.displayTags.length > 0 && (
									<div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-600 futura">
										{work.displayTags.map((tag: string) => (
											<span class="rounded-full border border-slate-300 px-3 py-1">{tag}</span>
										))}
									</div>
								)}
							</div>
							<span aria-hidden="true" class="mt-2 shrink-0 text-xl text-slate-300 transition group-hover:translate-x-1 group-hover:text-[#FF4081]">-></span>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>
</DefaultLayout>
