---
import DefaultLayout from "../layouts/DefaultLayout.astro"
import { Icon } from "astro-icon/components";
---
<DefaultLayout
	title="Social"
	description="mikio815のポートフォリオ"
>
	<section class="mt-24 space-y-10 text-slate-900">
		<header>
			<h2 class="text-6xl font-bold tussilago">Social</h2>
			<p class="mt-4 text-lg text-slate-600">普段の活動やイラストなどはこちらから</p>
		</header>
		<div class="flex flex-col gap-6 max-w-2xl">
			<a
				href="https://x.com/mikio815"
				class="flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-[#FF4081]/70 hover:shadow-lg"
			>
				<Icon name="mdi:twitter" class="text-5xl text-[#1DA1F2]" />
				<div>
					<p class="futura text-sm uppercase tracking-[0.3em] text-slate-500">Twitter</p>
					<p class="futura text-2xl">@mikio815</p>
				</div>
			</a>
			<a
				href="https://x.com/youalulu"
				class="flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-[#FF4081]/70 hover:shadow-lg"
			>
				<Icon name="mdi:twitter" class="text-5xl text-[#1DA1F2]" />
				<div>
					<p class="futura text-sm uppercase tracking-[0.3em] text-slate-500">Twitter</p>
					<p class="futura text-2xl">@youalulu (illustration)</p>
				</div>
			</a>
			<a
				href="https://github.com/mikio815"
				class="flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-[#FF4081]/70 hover:shadow-lg"
			>
				<Icon name="mdi:github" class="text-5xl text-slate-900" />
				<div>
					<p class="futura text-sm uppercase tracking-[0.3em] text-slate-500">GitHub</p>
					<p class="futura text-2xl">@mikio815</p>
				</div>
			</a>
		</div>
	</section>
</DefaultLayout>
