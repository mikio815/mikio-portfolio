---
import DefaultLayout from "../layouts/DefaultLayout.astro"
---
<DefaultLayout
	title="Home"
	description="mikio815のポートフォリオ"
>
	<section class="flex flex-col gap-12 text-slate-900">
		<div class="space-y-6">
			<p class="text-sm uppercase tracking-[0.18em] text-slate-500 futura">Security / CTF / 3D</p>
			<h1 class="text-5xl sm:text-6xl font-bold tussilago leading-tight">mikio815</h1>
			<div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
				<a href="/profile#about" class="inline-flex items-center justify-center px-6 py-3 rounded-full text-white bg-slate-900 shadow-lg shadow-slate-900/20 hover:translate-y-[1px] transition">About Me</a>
				<a href="/blog" class="inline-flex items-center justify-center px-6 py-3 rounded-full border border-slate-300 bg-white text-slate-900 hover:border-[#FF4081] transition">Blog</a>
			</div>
		</div>

		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			<a href="/skills" class="group rounded-2xl border border-slate-200 bg-white/70 p-5 shadow-sm hover:shadow-md hover:border-[#FF4081] transition">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-semibold futura">Tech</h2>
					<span class="text-slate-400 group-hover:text-slate-600 transition">→</span>
				</div>
				<p class="mt-2 text-sm text-slate-600">技術スタックなど</p>
			</a>
			<a href="/social" class="group rounded-2xl border border-slate-200 bg-white/70 p-5 shadow-sm hover:shadow-md hover:border-[#FF4081] transition">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-semibold futura">Social</h2>
					<span class="text-slate-400 group-hover:text-slate-600 transition">→</span>
				</div>
				<p class="mt-2 text-sm text-slate-600">SNS</p>
			</a>
			<a href="/contact" class="group rounded-2xl border border-slate-200 bg-white/70 p-5 shadow-sm hover:shadow-md hover:border-[#FF4081] transition">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-semibold futura">Contact</h2>
					<span class="text-slate-400 group-hover:text-slate-600 transition">→</span>
				</div>
				<p class="mt-2 text-sm text-slate-600">ご連絡はこちら</p>
			</a>
		</div>
	</section>
</DefaultLayout>
