---
import DefaultLayout from "../layouts/DefaultLayout.astro"

const works = await Astro.glob("./works/*.md")
    .then((items) =>
        items.map((item) => {
            const pageUrl = item.url ?? "";
            
            return {
                ...item,
                pageUrl,
                pubDate: item.frontmatter.pubDate ?? item.frontmatter.date ?? null,
            }
        })
    )

const formatLabel = (format?: string) => format?.toUpperCase() ?? "N/A"
---
<DefaultLayout
	title="Works"
	description="mikio815のポートフォリオ"
>
	<section class="mt-12 space-y-8 text-slate-900">
		<div class="space-y-3">
			<h2 class="text-6xl font-bold tussilago">Works</h2>
		</div>

		{works.length === 0 ? (
			<div class="rounded-2xl border border-slate-200 bg-white p-8 text-center text-slate-700 shadow-sm">
				まだ作品がありません。
			</div>
		) : (
			<div class="grid gap-6 lg:grid-cols-2">
				{works.map((work) => (
					<a
						href={work.pageUrl}
						class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-lg transition block"
					>
						<div class="absolute right-5 top-5 inline-flex items-center rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white shadow-sm">
							{formatLabel(work.frontmatter.format)}
						</div>
						<div class="px-5 pt-6 pb-4">
							<p class="text-sm uppercase tracking-[0.24em] text-slate-600 futura">
								{work.pubDate ? new Date(work.pubDate).toLocaleDateString("ja-JP") : "N/A"}
							</p>
							<h3 class="mt-2 text-2xl font-semibold text-slate-900">{work.frontmatter.title}</h3>
							<p class="mt-2 text-slate-700 leading-relaxed">{work.frontmatter.description}</p>
							{work.frontmatter.tags && (
								<div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-700">
									{work.frontmatter.tags.map((tag: string) => (
										<span class="rounded-full bg-white/80 px-3 py-1 border border-slate-200 shadow-sm">{tag}</span>
									))}
								</div>
							)}
						</div>

						<div class="px-5 pb-5 text-sm text-slate-600 flex items-center gap-2">
							<span class="rounded-full bg-slate-100 px-3 py-1 border border-slate-200">詳しく見る</span>
							<span class="text-slate-400 group-hover:text-slate-700 transition">→</span>
						</div>
					</a>
				))}
			</div>
		)}
	</section>
</DefaultLayout>
