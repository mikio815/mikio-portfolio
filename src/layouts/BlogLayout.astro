---
import "../styles/global.css"
import SocialLinks from "../components/SocialLinks.astro"
const { frontmatter } = Astro.props;

const SITE = {
	baseUrl: "https://mikio815.dev",
	title: "mikio815.dev",
	description: "mikio815のポートフォリオ",
	ogImage: "/icon.jpg",
}

const formattedPubDate = new Date(frontmatter.pubDate).toLocaleDateString(
	"ja-JP",
	{
		year: "numeric",
		month: "long",
		day: "numeric",
	},
)

const tags = Array.isArray(frontmatter.tags) ? frontmatter.tags : []
const pageTitle = `${frontmatter.title} | ${SITE.title}`
const pageDescription = frontmatter.description ?? SITE.description
const canonical = new URL(Astro.url.pathname, SITE.baseUrl).toString()
const resolvedOgImage = (() => {
	const source = frontmatter.ogImage ?? SITE.ogImage
	return source.startsWith("http")
		? source
		: new URL(source, SITE.baseUrl).toString()
})()
const publishedISO = new Date(frontmatter.pubDate).toISOString()
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="https://use.typekit.net/vpb1wur.css">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="article:published_time" content={publishedISO} />
  {tags.map((tag) => (
	  <meta property="article:tag" content={tag} />
  ))}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@mikio815" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={resolvedOgImage} />
</head>
<body class="m-0 p-0 text-gray-900 bg-[#ECEFF1]">
  <div class="flex flex-col min-h-screen lg:flex-row">
    <aside class="w-full px-6 py-6 lg:w-80 xl:w-96 lg:px-8 lg:py-10 lg:h-screen lg:fixed lg:top-0 lg:left-0 lg:flex lg:flex-col lg:overflow-y-auto lg:bg-[#ECEFF1] lg:z-10">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-bold tussilago lg:text-3xl">
          <a href="/">mikio815.dev</a>
        </h1>
        <SocialLinks class="w-full justify-start lg:hidden" />
      </div>
      <nav class="mt-8 flex flex-col gap-8 text-black flex-1" aria-label="Primary">
        <div class="flex gap-4 items-start">
          <img src="/profile.svg" alt="Profile navigation" class="w-6 h-auto lg:w-8" />
          <ul class="space-y-2 text-lg font-medium futura lg:text-2xl lg:space-y-4">
            <li>
              <a href="/profile#about" class="text-black transition-colors duration-200">About</a>
            </li>
            <li>
              <a href="/profile#career" class="text-black transition-colors duration-200">Career</a>
            </li>
            <li>
              <a href="/blog" class="text-black transition-colors duration-200">Blog</a>
            </li>
          </ul>
        </div>

        <div class="flex gap-4 items-start">
          <img src="/tech.svg" alt="Tech navigation" class="w-6 h-auto lg:w-8" />
          <ul class="space-y-2 text-lg font-medium futura lg:text-2xl lg:space-y-4">
            <li>
              <a href="/tech#skills" class="text-black transition-colors duration-200">Skills</a>
            </li>
            <li>
              <a href="/tech#works" class="text-black transition-colors duration-200">Works</a>
            </li>
          </ul>
        </div>

        <div class="flex gap-4 items-start">
          <img src="/contact.svg" alt="Contact navigation" class="w-6 h-auto lg:w-8" />
          <ul class="space-y-2 text-lg font-medium futura lg:text-2xl lg:space-y-4">
            <li>
              <a href="/social" class="text-black transition-colors duration-200">Social</a>
            </li>
            <li>
              <a href="/contact" class="text-black transition-colors duration-200">Contact</a>
            </li>
          </ul>
        </div>
      </nav>
      <SocialLinks class="hidden lg:flex mt-10 lg:mt-auto" />
    </aside>
    <div aria-hidden="true" class="hidden lg:block lg:w-80 xl:w-96 flex-shrink-0"></div>
    <main class="flex-1 w-full px-6 py-10 lg:px-16 lg:py-16">
      <div class="mx-auto w-full max-w-4xl">
        <section class="rounded-[32px] border border-white/20 bg-[#ECEFF1]/30 px-6 py-10 shadow-[0_12px_35px_rgba(0,0,0,0.05)] backdrop-blur sm:px-10">
          <p class="mb-4 text-xs uppercase tracking-[0.6em] text-gray-400 futura">entry</p>
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="space-y-4">
              <h1 class="heading-jp text-3xl md:text-4xl leading-tight">{frontmatter.title}</h1>
              {frontmatter.description && (
                <p class="text-lg text-gray-600 leading-relaxed max-w-2xl">
                  {frontmatter.description}
                </p>
              )}
            </div>
            <div class="text-right">
              <p class="futura text-xs uppercase tracking-[0.4em] text-gray-400 mb-1">published</p>
              <p class="futura text-2xl">{formattedPubDate}</p>
            </div>
          </div>
          {tags.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {tags.map((tag) => (
                <span class="rounded-full border border-white/30 bg-white/10 px-4 py-1 text-[0.65rem] tracking-[0.3em] uppercase text-gray-600 futura">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </section>
        <article class="post-content mt-12 rounded-[32px] border border-white/20 bg-[#ECEFF1]/25 px-6 py-12 shadow-[0_10px_35px_rgba(0,0,0,0.04)] backdrop-blur sm:px-10">
          <slot />
        </article>
      </div>
    </main>
  </div>
</body>
</html>
