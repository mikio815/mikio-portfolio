---
import DefaultLayout from "./DefaultLayout.astro"
import { normalizeLocale, type Locale } from "../data/siteLocale"

const { frontmatter } = Astro.props
const locale: Locale = normalizeLocale(frontmatter.locale, Astro.url.pathname)
const formattedPubDate = new Date(frontmatter.pubDate).toLocaleDateString(
	locale === "en" ? "en-US" : "ja-JP",
	{
		year: "numeric",
		month: "long",
		day: "numeric",
	},
)
const tags = Array.isArray(frontmatter.tags) ? frontmatter.tags : []
const pageDescription = frontmatter.description
const publishedISO = new Date(frontmatter.pubDate).toISOString()
const backLabel = locale === "en" ? "Back to blog" : "一覧に戻る"
const backHref = locale === "en" ? "/en/blog" : "/blog"
---
<DefaultLayout
	title={frontmatter.title}
	description={pageDescription}
	ogImage={frontmatter.ogImage}
	ogType="article"
	locale={locale}
>
	<Fragment slot="head">
		<meta property="article:published_time" content={publishedISO} />
		{tags.map((tag: string) => (
			<meta property="article:tag" content={tag} />
		))}
	</Fragment>

	<div class="w-full max-w-4xl mr-auto">
		<header class="space-y-5">
			<p class="text-xs uppercase tracking-[0.4em] text-gray-400 futura">entry</p>
			<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
				<h1 class="heading-jp text-3xl md:text-4xl leading-tight">{frontmatter.title}</h1>
				<p class="futura shrink-0 text-sm text-gray-500">{formattedPubDate}</p>
			</div>
			{frontmatter.description && (
				<p class="text-lg text-gray-600 leading-relaxed">{frontmatter.description}</p>
			)}
			{tags.length > 0 && (
				<div class="flex flex-wrap gap-2 text-xs text-gray-600 futura">
					{tags.map((tag: string) => (
						<span class="rounded-full border border-slate-300 px-3 py-1 uppercase tracking-[0.15em]">{tag}</span>
					))}
				</div>
			)}
		</header>
		<article class="post-content mt-10 border-t border-slate-300 pt-10">
			<slot />
		</article>
		<div class="mt-12 border-t border-slate-300 pt-8">
			<a
				href={backHref}
				class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-medium text-slate-800 transition hover:-translate-y-[1px] hover:border-[#FF4081]"
				aria-label={backLabel}
			>
				<span aria-hidden="true">←</span>
				<span>{backLabel}</span>
			</a>
		</div>
	</div>
</DefaultLayout>
