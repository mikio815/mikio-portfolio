---
import "../styles/global.css"
import SocialLinks from "../components/SocialLinks.astro"
import MobileMenu from "../components/MobileMenu.astro"

const SITE = {
	baseUrl: "https://mikio815.dev",
	title: "mikio815.dev",
	description: "mikio815のポートフォリオ",
	ogImage: "/OGP.png",
}

const { title, description, ogImage } = Astro.props
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title
const pageDescription = description ?? SITE.description
const canonical = new URL(Astro.url.pathname, SITE.baseUrl).toString()
const resolvedOgImage = (() => {
	if (!ogImage) {
		return new URL(SITE.ogImage, SITE.baseUrl).toString()
	}
	return ogImage.startsWith("http")
		? ogImage
		: new URL(ogImage, SITE.baseUrl).toString()
})()
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://use.typekit.net" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://use.typekit.net/vpb1wur.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@mikio815" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={resolvedOgImage} />
</head>
<body class="m-0 p-0 text-gray-900 bg-[#ECEFF1]">
  <div class="flex flex-col min-h-screen lg:flex-row">
    <!-- モバイル用トップバー -->
    <header class="flex items-center justify-between px-6 py-4 lg:hidden">
      <h1 class="text-2xl font-bold tussilago">
        <a href="/">mikio815.dev</a>
      </h1>
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex flex-col items-center justify-center gap-1.5 w-12 h-12 shrink-0 rounded-full border border-slate-300 bg-white shadow-md shadow-slate-300/60 ring-2 ring-white/70 active:scale-[0.97] transition"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        <span class="block h-0.5 w-6 bg-slate-800"></span>
        <span class="block h-0.5 w-6 bg-slate-800"></span>
        <span class="block h-0.5 w-6 bg-slate-800"></span>
      </button>
    </header>

    <aside class="hidden w-full px-6 py-6 lg:w-72 xl:w-80 lg:px-8 lg:py-10 lg:h-screen lg:fixed lg:top-0 lg:left-0 lg:flex lg:flex-col lg:overflow-y-auto lg:bg-[#ECEFF1] lg:z-10">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-bold tussilago lg:text-3xl">
          <a href="/">mikio815.dev</a>
        </h1>
        <SocialLinks class="w-full justify-start lg:hidden" />
      </div>
      <nav class="mt-8 flex flex-col gap-12 text-black flex-1" aria-label="Primary">
        <div class="flex items-stretch gap-4">
          <span class="writing-vertical-lr text-sm font-normal futura lg:text-base text-black leading-none">Profile</span>
          <span class="block self-stretch w-[1.5px] h-full bg-slate-800/70"></span>
          <ul class="space-y-3 text-lg font-medium futura lg:text-2xl lg:space-y-5">
            <li>
              <a href="/profile" class="text-black transition-colors duration-200">About</a>
            </li>
            <li>
              <a href="/profile#career" class="text-black transition-colors duration-200">Career</a>
            </li>
            <li>
              <a href="/blog" class="text-black transition-colors duration-200">Blog</a>
            </li>
          </ul>
        </div>

        <div class="flex items-stretch gap-4">
          <span class="writing-vertical-lr text-sm font-normal futura lg:text-base text-black leading-none">Tech</span>
          <span class="block self-stretch w-[1.5px] h-full bg-slate-800/70"></span>
          <ul class="space-y-3 text-lg font-medium futura lg:text-2xl lg:space-y-5">
            <li>
              <a href="/skills" class="text-black transition-colors duration-200">Skills</a>
            </li>
            <li>
              <a href="/works" class="text-black transition-colors duration-200">Works</a>
            </li>
          </ul>
        </div>

        <div class="flex items-stretch gap-4">
          <span class="writing-vertical-lr text-sm font-normal futura lg:text-base text-black leading-none">Contact</span>
          <span class="block self-stretch w-[1.5px] h-full bg-slate-800/70"></span>
          <ul class="space-y-3 text-lg font-medium futura lg:text-2xl lg:space-y-5">
            <li>
              <a href="/social" class="text-black transition-colors duration-200">Social</a>
            </li>
            <li>
              <a href="/contact" class="text-black transition-colors duration-200">Contact</a>
            </li>
          </ul>
        </div>
      </nav>
      <SocialLinks class="hidden lg:flex mt-10 lg:mt-auto" />
    </aside>
    <div aria-hidden="true" class="hidden lg:block lg:w-72 xl:w-80 flex-shrink-0"></div>
    <main class="flex-1 w-full px-6 py-10 lg:px-10 lg:py-14">
      <slot />
    </main>
  </div>

  <MobileMenu />

  <script is:inline>
    const btn = document.getElementById("mobile-menu-button");
    const closeBtn = document.getElementById("mobile-menu-close");
    const overlay = document.getElementById("mobile-menu-overlay");
    const openMenu = () => {
      if (!overlay) return;
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100");
      btn?.setAttribute("aria-expanded", "true");
      document.body.classList.add("overflow-hidden");
    };
    const closeMenu = () => {
      if (!overlay) return;
      overlay.classList.add("pointer-events-none");
      overlay.classList.remove("opacity-100");
      overlay.classList.add("opacity-0");
      btn?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("overflow-hidden");
    };
    btn?.addEventListener("click", openMenu);
    closeBtn?.addEventListener("click", closeMenu);
    overlay?.addEventListener("click", (e) => {
      const panel = overlay.querySelector("[data-mobile-menu-panel]");
      if (e.target === overlay || e.target === overlay.querySelector("[data-mobile-menu-backdrop]")) {
        closeMenu();
      } else if (panel && !panel.contains(e.target)) {
        closeMenu();
      }
    });
    overlay?.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", closeMenu);
    });
  </script>
</body>
</html>
