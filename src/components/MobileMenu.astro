---
import SocialLinks from "./SocialLinks.astro"
import {
	getAlternateLocalePath,
	getNavGroups,
	normalizeLocale,
	siteCopy,
} from "../data/siteLocale"

const locale = normalizeLocale(Astro.props.locale, Astro.url.pathname)
const copy = siteCopy[locale]
const navGroups = getNavGroups(locale)
const alternatePath =
	Astro.props.alternatePath ?? getAlternateLocalePath(Astro.url.pathname, locale)
---
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-40 bg-black/40 backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-200 lg:hidden"
  aria-hidden="true"
>
  <div class="absolute inset-0" aria-hidden="true" data-mobile-menu-backdrop></div>
  <div
    class="absolute top-0 right-0 bottom-0 w-[72vw] max-w-[320px] bg-white shadow-2xl px-6 py-14 flex flex-col gap-12"
    data-mobile-menu-panel
  >
    <div class="flex items-center justify-between">
      <span class="text-xl font-bold tussilago">{copy.menu}</span>
      <button
        id="mobile-menu-close"
        type="button"
        class="relative flex h-12 w-12 items-center justify-center rounded-full hover:bg-slate-100 transition"
        aria-label={copy.closeNavigation}
      >
        <span class="absolute block h-[2px] w-6 bg-slate-800 rotate-45"></span>
        <span class="absolute block h-[2px] w-6 bg-slate-800 -rotate-45"></span>
      </button>
    </div>

    <nav class="flex flex-col gap-12 text-slate-900 w-full max-w-[280px] mx-auto" aria-label="Mobile Primary">
      {navGroups.map((group) => (
        <div class="grid w-full grid-cols-[100px_1fr] items-start gap-x-8">
          <p class="col-span-1 text-right min-w-[100px] whitespace-nowrap text-sm font-semibold tracking-[0.24em] text-slate-700 uppercase futura leading-6">{group.label}</p>
          <ul class="col-span-1 w-full space-y-4 text-[26px] font-normal futura leading-tight">
            {group.items.map((item) => (
              <li><a href={item.href} class="hover:text-[#FF4081] transition">{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="mt-auto space-y-5">
      <a
        href={alternatePath}
        class="inline-flex items-center py-2 futura text-sm uppercase tracking-[0.18em] text-slate-600 transition hover:text-[#FF4081]"
        aria-label={copy.switchLanguageAria}
      >
        {copy.switchLanguage}
      </a>
      <SocialLinks class="justify-start gap-4" />
    </div>
  </div>
</div>
